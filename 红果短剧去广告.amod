[Module]
name = 红果短剧去广告
icon-light = 
description = 来源：许舟 (zhiaon/Modules) V1.3 ｜ 红果短剧纯域名层去广告：穿山甲 SDK、字节广告位、广告素材与埋点，不需要 MITM 与证书。

[Routing]
# 红果短剧去广告 - Anywhere Routing RuleSet (REJECT)
# 类型: 0=IPv4 CIDR, 1=IPv6 CIDR, 2=域名后缀, 3=域名关键字

name = 红果短剧去广告 Reject
routing = 2

